# Night Shift — copy to .env and fill in. Never commit .env.
#
# Deterministic offline work (make test, make verify-demo) needs none of these.
# Live Google Cloud work needs all of them.

# --- Google Cloud -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Regional infrastructure. Gemini 3.5 Flash is served from the `global` Vertex
# endpoint, so the model location and the infrastructure region differ on purpose.
NIGHTSHIFT_REGION=us-central1
NIGHTSHIFT_MODEL_LOCATION=global
NIGHTSHIFT_MODEL=gemini-3.5-flash

# --- Evidence -----------------------------------------------------------------
NIGHTSHIFT_EVIDENCE_BUCKET=nightshift-evidence-your-project-id
NIGHTSHIFT_KMS_KEY=projects/your-project-id/locations/us-central1/keyRings/nightshift/cryptoKeys/evidence-signer/cryptoKeyVersions/1
# auto = use KMS when the key is reachable, else the local key. Also: kms | local | none
NIGHTSHIFT_SIGNER=auto

# --- Governance ---------------------------------------------------------------
NIGHTSHIFT_MODEL_ARMOR_TEMPLATE=projects/your-project-id/locations/us-central1/templates/nightshift-vendor-content
NIGHTSHIFT_REGISTRY_LOCATION=us-central1
NIGHTSHIFT_MEMORY_BANK=

# --- Runtime ------------------------------------------------------------------
# memory = deterministic in-process store; firestore = live operational plane
NIGHTSHIFT_STORE=memory
NIGHTSHIFT_NAMESPACE=demo
NIGHTSHIFT_TRACING=0
NIGHTSHIFT_ENV=local

# HMAC secret backing local agent principal tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NIGHTSHIFT_AGENT_SECRET=change-me-for-any-shared-environment

# --- Service URLs (set by the deploy script; blank means in-process) ----------
NIGHTSHIFT_TELEMETRY_URL=
NIGHTSHIFT_INVENTORY_URL=
NIGHTSHIFT_CAPACITY_URL=
NIGHTSHIFT_FACILITIES_URL=
NIGHTSHIFT_CUSTODY_URL=
NIGHTSHIFT_INCIDENT_URL=
NIGHTSHIFT_GATEWAY_URL=
