  "cards": [
    {
      "dot": "cyan",
      "title": "The one rule",
      "items": [
        "Agents decide what to do; deterministic code decides what becomes true",
        "No LLM ever writes to Firestore directly"
      ]
    },
    {
      "dot": "amber",
      "title": "Refusal is a first-class outcome",
      "items": [
        "An unsafe action is refused with the invariant that blocked it",
        "Closure is refused while any impacted container is unreconciled"
      ]
    },
    {
      "dot": "violet",
      "title": "Authority, four layers deep",
      "items": [
        "Toolset construction, broker, service route guard, Cloud Run IAM",
        "Exactly one agent holds each write domain"
      ]
    }
