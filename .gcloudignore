# Anchored with a leading slash on purpose. An unanchored `evidence/` also matches
# `nightshift/evidence/`, which silently stripped a package out of the build context
# and produced a ModuleNotFoundError only at container start.
/.git/
/.venv/
/node_modules/
/apps/web/node_modules/
/apps/web/.next/
/keys/
/tests/
/.env
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/
__pycache__/
*.pyc

# Published evidence ships WITH the image. The manifests, campaign results, and claim
# ledger are what the public evidence, drills, and proof surfaces read; excluding them
# left three judge-facing pages empty in production while looking fine locally.
# Only scratch output is excluded.
/evidence/scratch/
