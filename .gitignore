# Evidence: generated campaign output is committed deliberately via `make evidence`,
# but scratch runs are not.
evidence/scratch/
evidence/**/*.tmp

# Regenerable diagram QA output. The specifications and the delivered HTML are tracked;
# the containment screenshots and receipts are rebuilt on demand.
docs/diagrams/*.visual-check.*
